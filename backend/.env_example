# Puerto del servidor
PORT=3000

# Base de datos (PostgreSQL / Supabase)
DATABASE_URL=postgres://[POSTGRES_USER]:[POSTGRES_PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Secreto para firmar y verificar JSON Web Tokens (JWT)
JWT_SECRET=[CLAVE SECRETA PARA FIRMAR JWT]

# Selección de estrategia api key. Valores aceptados: STATIC, HMAC
API_VALIDATOR_TYPE=STATIC

# Clave para la estrategia Static Key
API_KEY=[CLAVE ESTÁTICA PARA API KEY]

# Secreto para la estrategia HMAC
HMAC_SECRET=[CLAVE SECRETA PARA HMAC]

# Selección de servicio de notificaciones. Valores aceptados: MOCK, EXPO
NOTIFICATION_PROVIDER=MOCK